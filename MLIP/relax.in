variable b loop 100

label loopa

variable a equal ${b}

units           metal
atom_style	atomic
boundary        p p p

read_data        ${a}.data

mass            1 95.95 # Mo
mass            2 92.90638 # Nb
mass            3 180.94788 # Ta
mass            4 183.84 # W
mass            5 1 # H


pair_style mlip ../mlip.ini 
pair_coeff * *

neighbor	0.5 bin
neigh_modify    every 1 delay 5 check yes

timestep	0.001

thermo		10

thermo_style custom step temp pe press pxx pyy pzz pxy pxz pyz lx ly lz vol


min_style cg

minimize 0 0.001 1000 10000

write_data ${a}-relax.data

run 0

variable mype equal pe

print "${mype}" append pe.txt screen no

clear

next b

jump relax.in loopa 